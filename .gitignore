# ---------------------------------------------------------------
# StoneAdventure / 磐石之旅
# 默认忽略仓库根目录下的一切，只放行需要版本管理的内容。
# ---------------------------------------------------------------
/*

# 行为包与资源包
!/磐石之旅BP/
!/磐石之旅RP/

# 项目文档
!/README.md
!/README.en.md
!/README.zh-TW.md
!/README.ru.md
!/LICENSE
!/LICENSE-ASSETS.md
!/THIRD-PARTY-NOTICES.md
!/CHANGELOG.md
!/changelog.md
!/CONTRIBUTING.md
!/.gitignore

# GitHub 协作配置
!/.github/

# ---------------------------------------------------------------
# 任何层级都不纳入版本控制的杂项
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*~

# 打包产物
*.mcaddon
*.mcpack
*.zip
*.backup

# 编辑器目录
.vscode/
.idea/
