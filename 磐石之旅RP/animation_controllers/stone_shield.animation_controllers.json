{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.stonecraft.shield.wield": {
			"initial_state": "first_person",
			"states": {
				"first_person": {
					"animations": [
						{
							"wield_main_hand_first_person": "c.item_slot == 'main_hand'"
						},
						{
							"wield_off_hand_first_person": "c.item_slot != 'main_hand'"
						}
					],
					"transitions": [
						{
							"third_person": "!c.is_first_person"
						},
						{
							"blocking_first_person": "query.is_sneaking"
						}
					],
					"blend_transition": 0.1
				},
				"blocking_first_person": {
					"animations": [
						{
							"wield_main_hand_first_person_block": "c.item_slot == 'main_hand'"
						},
						{
							"wield_off_hand_first_person_block": "c.item_slot != 'main_hand'"
						}
					],
					"transitions": [
						{
							"third_person": "!c.is_first_person"
						},
						{
							"first_person": "!query.is_sneaking"
						}
					],
					"blend_transition": 0.1
				},
				"third_person": {
					"animations": [
						"wield_third_person"
					],
					"transitions": [
						{
							"first_person": "c.is_first_person && !query.is_sneaking"
						},
						{
							"blocking_first_person": "c.is_first_person && query.is_sneaking"
						}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}
