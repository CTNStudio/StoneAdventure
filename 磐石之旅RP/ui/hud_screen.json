                  },
                  {
                    "item_text_label": {
                      "type": "label",
                      "max_size": [
                        200,
                        "default"
                      ],
                      "text_alignment": "center",
                      "layer": 31,
                      "color": "$text_color",
                      "text": "#text",
                      "alpha": "@hud.anim_item_name_text_alpha_in",
                      "shadow": true,
                      "bindings": [
                        {
                          "binding_name": "$text_binding",
