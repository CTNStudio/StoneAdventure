{
  "namespace": "hud",
  "toasty": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      "100%",
      "100%c"
    ],
    "max_size": [
      "100%",
      "50%"
    ],
    "controls": [
      {
        "stack_panel": {
          "type": "stack_panel",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "use_child_anchors": true,
          "factory": {
            "name": "chat_item_factory",
            "max_children_size": 50,
            "control_ids": {
              "chat_item": "achievement_stacked@hud.achievement_stacked"
            }
          }
        }
      }
    ]
  },
  "achievement_animation_in": {
    "anim_type": "offset",
    "easing": "out_quart",
    "duration": 1,
    "from": [
      "14% + 180px",
      30
    ],
    "to": [
      0,
      30
    ],
    "next": "@hud.achievement_animation_stay"
  },
  "achievement_animation_stay": {
    "anim_type": "wait",
    "duration": 6.7,
    "next": "@hud.achievement_animation_out"
  },
  "achievement_animation_out": {
    "anim_type": "offset",
    "easing": "in_quart",
    "duration": 1,
    "from": [
      0,
      30
    ],
    "to": [
      "14% + 180px",
      30
    ],
    "destroy_at_end": "chat_grid_item"
  },
  "achievement_element": {
    "layer": 1,
    "type": "image",
    "texture": "textures/ui/achievement_temp",
    "anims": [
      "@hud.achievement_animation_in"
    ],
    "$when_draw|default": "unknown",
    "$content_text|default": "Unknown",
    "$achievement_text|default": "Unknown",
    "$achievement_icon|default": "textures/ui/crafting",
    "clips_children": true,
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [
      0,
      33
    ],
    "size": [
      163,
      33
    ],
    "uv_size": [
      163,
      32
    ],
    "$uv|default": [
      0,
      0
    ],
    "uv": "$uv",
    "controls": [
      {
        "achievement_icon_texture": {
          "type": "image",
          "texture": "$achievement_icon",
          "layer": 3,
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [
            "-84.0%",
            "-2.4%"
          ],
          "size": [
            19,
            19
          ]
        }
      },
      {
        "achievement_title": {
          "type": "label",
          "color": "$main_header_text_color",
          "layer": 2,
          "shadow": true,
          "offset": [
            "18%",
            -5
          ],
          "text": "$achievement_text",
          "size": [
            "default",
            12
          ],
          "max_size": [
            "100%",
            "100%"
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "localize": true
        }
      },
      {
        "achievement_content_texts": {
          "type": "label",
          "shadow": true,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "color": "$main_header_text_color",
          "text": "$content_text",
          "layer": 2,
          "offset": [
            "18%",
            5
          ],
          "localize": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#chat_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "chat_text_grid",
        "binding_condition": "once"
      },
      {
        "binding_type": "view",
        "source_property_name": "((('%.10s' * #text) = 'bob.toast;') and ((#text - ('%.10s' * #text)) = $when_draw))",
        "target_property_name": "#visible"
      }
    ]
  },
  "achievement_stacked": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ "100%c", "100%c" ],
    "controls": [
      {
        "pudding": {
          "type": "panel",
          "size": [ 0, 2 ]
        }
      },
      {
        "custom.achievement.cobblestone_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.cobblestone_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/ui/quest/cobblestone",
          "$achievement_text": "sc.quest.cobblestone_ach.title",
          "$content_text": "sc.quest.cobblestone_ach.body"
        }
      },
      {
        "custom.achievement.andesite_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.andesite_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/ui/quest/andesite_ach",
          "$achievement_text": "sc.quest.andesite_ach.title",
          "$content_text": "sc.quest.andesite_ach.body"
        }
      },
      {
        "custom.achievement.stone_guard_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.stone_guard_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/ui/quest/entities/stone_guard",
          "$achievement_text": "sc.quest.stone_guard_ach.title",
          "$content_text": "sc.quest.stone_guard_ach.body"
        }
      },
      {
        "custom.achievement.stone_shooter_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.stone_shooter_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/ui/quest/entities/stone_shooter",
          "$achievement_text": "sc.quest.stone_shooter_ach.title",
          "$content_text": "sc.quest.stone_shooter_ach.body"
        }
      },
      {
        "custom.achievement.spire_remnant_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.spire_remnant_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/ui/quest/entities/spire_remnant",
          "$achievement_text": "sc.quest.spire_remnant_ach.title",
          "$content_text": "sc.quest.spire_remnant_ach.body"
        }
      },
      {
        "custom.achievement.hit_with_arrow_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.hit_with_arrow_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/items/stone_arrow",
          "$achievement_text": "sc.ach.hit_with_arrow.title",
          "$content_text": "sc.ach.hit_with_arrow.body"
        }
      },
      {
        "custom.achievement.stone_food_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.stone_food_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/items/foods/stone_bread",
          "$achievement_text": "sc.quest.stone_food_ach.title",
          "$content_text": "sc.quest.stone_food_ach.body"
        }
      },
      {
        "custom.achievement.stone_baguette_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.stone_baguette_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/items/foods/stone_bread",
          "$achievement_text": "sc.quest.stone_baguette_ach.title",
          "$content_text": "sc.quest.stone_baguette_ach.body"
        }
      },
      {
        "custom.achievement.stone_food_collector_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.stone_food_collector_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/items/foods/stone_bread",
          "$achievement_text": "sc.quest.stone_food_collector_ach.title",
          "$content_text": "sc.quest.stone_food_collector_ach.body"
        }
      },
      {
        "custom.achievement.stone_totem_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.stone_totem_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/ui/quest/entities/ancient_stone_totem",
          "$achievement_text": "sc.quest.stone_totem_ach.title",
          "$content_text": "sc.quest.stone_totem_ach.body"
        }
      },
      {
        "custom.achievement.lv5stone_armors_ach@hud.achievement_element": {
          "$when_draw": "custom.achievement.lv5stone_armors_ach",
          "$uv": [ 0, 0 ],
          "$achievement_icon": "textures/items/armors/chestplates/lv5",
          "$achievement_text": "sc.quest.lv5stone_armors.title",
          "$content_text": "sc.quest.lv5stone_armors.body"
        }
      }
    ]
  },
  "chat_label": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": {
          "binding_type": "view",
          "source_property_name": "(not (('%.10s' * #text) = 'bob.toast;'))",
          "target_property_name": "#visible"
        }
      }
    ],
    "type": "label",
    "layer": 31,
    "text": "#text",
    "size": [
      "100%",
      "default"
    ],
    "shadow": true,
    "localize": false,
    "color": "$chat_text_color",
    "enable_profanity_filter": true,
    "font_type": "$chat_font_type",
    "font_scale_factor": "$chat_font_scale_factor",
    "line_padding": "$chat_line_spacing",
    "anims": [
      "@hud.anim_chat_txt_wait"
    ],
    "bindings": [
      {
        "binding_name": "#chat_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "chat_text_grid",
        "binding_condition": "once"
      }
    ]
  },
  "root_panel": {
    "type": "panel",
    "$xp_control_offset|default": [
      0,
      -13
    ],
    "variables": [
      {
        "requires": "$education_edition",
        "$left_helpers": "hud.left_helpers_edu"
      },
      {
        "requires": "(not $education_edition)",
        "$left_helpers": "hud.left_helpers"
      }
    ],
    "controls": [
      {
        "toast_panel@hud.toasty": {}
      },
      {
        "layout_customization_reset": {
          "type": "image",
          "size": [
            "200%",
            "200%"
          ],
          "texture": "textures/ui/Black.png",
          "fill": true,
          "alpha": 0.5,
          "layer": 50,
          "controls": [
            {
              "layout_customization_reset_modal@common_dialogs.main_panel_two_buttons": {
                "size": [
                  210,
                  160
                ],
                "$show_close_button": false,
                "$child_control": "library_modal.modal_text_content",
                "$top_button_panel": "hud.wysiwyg_reset_modal_ok",
                "$bottom_button_panel": "hud.wysiwyg_reset_modal_cancel",
                "$modal_text": "hudScreen.controlCustomization.resetModalText"
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#reset_modal_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "layout_customization_close_without_saving": {
          "type": "image",
          "size": [
            "200%",
            "200%"
          ],
          "texture": "textures/ui/Black.png",
          "fill": true,
          "alpha": 0.5,
          "layer": 50,
          "controls": [
            {
              "layout_customization_close_without_saving_modal@common_dialogs.main_panel_two_buttons": {
                "size": [
                  210,
                  160
                ],
                "$show_close_button": false,
                "$child_control": "library_modal.modal_text_content",
                "$top_button_panel": "hud.wysiwyg_close_without_saving_modal_ok",
                "$bottom_button_panel": "hud.wysiwyg_close_without_saving_modal_cancel",
                "$modal_text": "hudScreen.controlCustomization.closeWithoutSavingModalText"
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#close_without_saving_modal_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "layout_customization_main_panel@hud.layout_customization_main_panel": {}
      },
      {
        "layout_customization_sub_panel@hud.layout_customization_sub_panel": {}
      },
      {
        "layout_customization_hint_drag_frame": {
          "type": "image",
          "layer": 40,
          "use_anchored_offset": true,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "property_bag": {
            "#anchored_offset_value_y": 0
          },
          "texture": "textures/ui/Black",
          "size": [
            "100%c+5px",
            "100%c+2px"
          ],
          "alpha": 0.5,
          "controls": [
            {
              "layout_customization_hint_drag": {
                "type": "label",
                "text": "hudScreen.controlCustomization.hintDrag",
                "color": "$f_color_format"
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#hint_drag_visible",
              "binding_name_override": "#visible"
            },
            {
              "binding_name": "#layout_customization_hint_offset_y",
              "binding_name_override": "#anchored_offset_value_y",
              "binding_condition": "visible"
            }
          ]
        }
      },
      {
        "layout_customization_hint_deselect_frame": {
          "type": "image",
          "layer": 40,
          "use_anchored_offset": true,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "property_bag": {
            "#anchored_offset_value_y": 0
          },
          "texture": "textures/ui/Black",
          "size": [
            "100%c+5px",
            "100%c+2px"
          ],
          "alpha": 0.5,
          "controls": [
            {
              "layout_customization_hint_deselect": {
                "type": "label",
                "text": "hudScreen.controlCustomization.hintDeselect",
                "color": "$f_color_format"
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#hint_deselect_visible",
              "binding_name_override": "#visible"
            },
            {
              "binding_name": "#layout_customization_hint_offset_y",
              "binding_name_override": "#anchored_offset_value_y",
              "binding_condition": "visible"
            }
          ]
        }
      },
      {
        "layout_customization_hint_saved": {
          "type": "image",
          "layer": 40,
          "use_anchored_offset": true,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "property_bag": {
            "#anchored_offset_value_y": 0
          },
          "texture": "textures/ui/Black",
          "size": [
            "100%c+5px",
            "100%c+2px"
          ],
          "alpha": 0.5,
          "controls": [
            {
              "layout_customization_hint_saved": {
                "type": "label",
                "text": "hudScreen.controlCustomization.hintSaved",
                "color": "$f_color_format"
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#hint_saved_visible",
              "binding_name_override": "#visible"
            },
            {
              "binding_name": "#layout_customization_hint_offset_y",
              "binding_name_override": "#anchored_offset_value_y",
              "binding_condition": "visible"
            }
          ]
        }
      },
      {
        "left_helpers@$left_helpers": {}
      },
      {
        "right_helpers@hud.right_helpers": {}
      },
      {
        "subtitle_container_host": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "factory": {
            "name": "subtitle_container_factory",
            "max_children_size": 1,
