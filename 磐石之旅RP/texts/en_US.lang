## 七兆印石 lore
stonecraft.septem_seal_line_1=§8Unseals the Sevenfold Seal when used
stonecraft.septem_seal_line_2=§cSeven Curses
stonecraft.septem_seal_line_3=§7· Petrified: slowed, always hungry, mining fatigue, weakened strikes
stonecraft.septem_seal_line_4=§7· Take more damage; stone heart heals at half rate
stonecraft.septem_seal_line_5=§7· Cannot trade with villagers or wandering traders
stonecraft.septem_seal_line_6=§7· Tools and armor wear twice as fast
stonecraft.septem_seal_line_7=§7· Neutral creatures are no longer friendly
stonecraft.septem_seal_line_8=§7· Blinded in the dark
stonecraft.septem_seal_line_9=§7· Can never sleep
stonecraft.septem_seal_line_10=§aSeven Blessings
stonecraft.septem_seal_line_11=§7· Slaying stone-born creatures yields stone essence
stonecraft.septem_seal_line_12=§7· Slaying creatures grants extra experience
stonecraft.septem_seal_line_13=§7· Weekly completion rewards are doubled
stonecraft.septem_seal_line_14=§7· Immune to the Warden's sonic boom
stonecraft.septem_seal_line_15=§7· Keep more experience on death
stonecraft.septem_seal_line_16=§7· Doll effects are doubled
stonecraft.septem_seal_line_17=§7· Unleash the true power of some weapons

## 七兆印石界面与提示
stonecraft.septem.title=§5Sevenfold Seal
stonecraft.septem.line1=You will bear seven curses.
stonecraft.septem.line2=Seven blessings take effect too.
stonecraft.septem.line3=Curses can be lifted one by one, at a cost.
stonecraft.septem.ask=Unseal it now?
stonecraft.septem.ok=Confirm
