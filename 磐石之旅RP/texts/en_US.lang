sc.ach.cobblestone.body=Welcome to Stone Adventure!
sc.ach.andesite.title=Obtain Andesite
sc.ach.andesite.body=Press W to Ponder.jpg
sc.ach.stone_guard.title=Stone Genie
sc.ach.stone_guard.body=Bro, I found that farming Stone Guards gives more stone than mining it.
sc.ach.stone_shooter.title=Stone Genie 2.0
sc.ach.stone_shooter.body=Bro, why are this guy's arrows different?
sc.ach.spire_remnant.title=Such a Dark Heart
sc.ach.spire_remnant.body=Tasty... yeah right.
sc.ach.hit_with_arrow.title=Sharpshooter
sc.ach.hit_with_arrow.body=Hit entities 640 times with Stone Arrows
sc.ach.stone_food.title=Stone Foodie
sc.ach.stone_food.body=Eat any Stone Food item.
sc.ach.stone_baguette.title=Baguette Enthusiast
sc.ach.stone_baguette.body=The signature self-defense weapon of every Frenchman.
sc.ach.stone_food_collector.title=Stoned Feaster
sc.ach.stone_food_collector.body=Eat every type of Stone Food.
sc.ach.stone_totem.title=Four Omens Undone
sc.ach.stone_totem.body=Defeat the Stone Totem once
sc.ach.lv5stone_armors.title=Level 5 Compressed Stone Armor Set
sc.ach.lv5stone_armors.body=Collect the full Level 5 Compressed Stone Armor set

