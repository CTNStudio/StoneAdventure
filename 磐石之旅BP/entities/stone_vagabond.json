{
  "format_version": "1.20.70",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:stone_vagabond",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "stonecraft:start_angry":{
        "minecraft:timer": {
          "looping": false,
          "time": 8.0,
          "time_down_event": {
            "event": "minecraft:become_hostile"
          }
        }
      },
      "stonecraft:molten_sensor": {
        "minecraft:environment_sensor": {
          "triggers": {
            "filters": {
              "any_of": [
                    { "test": "on_fire", "operator": "==", "value": true},
                    { "test": "in_nether", "operator": "==", "value": true }
                ]
            },
            "event": "stonecraft:start_molten_event"
          }
        }
      },
      "stonecraft:start_molten": {
        "minecraft:environment_sensor": {
          "triggers": {
            "filters": {
              "all_of": [
                    { "test": "on_fire", "subject": "self", "operator": "!=", "value": true},
                    { "test": "in_nether", "subject": "self", "operator": "!=", "value": true }
              ]
            },
            "event": "stonecraft:stop_molten_event"
          }
        },
        "minecraft:timer": {
          "looping": false,
          "time": 2.5,
          "time_down_event": {
            "event": "stonecraft:become_molten_event"
          }
        }
      },
      "stonecraft:become_molten": {
        "minecraft:transformation": {
          "into": "stonecraft:molten_stone_vagabond",
          //"transformation_sound" : "converted_to_zombified",
          "drop_inventory": true,
          "preserve_equipment": true
        }
      },
      "minecraft:peaceful": {
        /*
        //失败示例（其实现在也是失败的）
        "minecraft:environment_sensor": {
          "triggers": {
            "filters": {
              "any_of": [
                    { "test": "distance_to_nearest_player", "operator": "<=", "value": 10.0}
                ]
            },
            "event": "minecraft:start_angry_event"
          }
        },
        "minecraft:entity_sensor": {
            "sensor_range": 10,
            "event_filters": { 
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "event": "minecraft:start_angry_event"
        },*/
        "minecraft:target_nearby_sensor": {
          "inside_range": 10,
          "on_inside_range": {
            "event": "minecraft:start_angry_event",
            "target": "self"
          },
          "on_outside_range": {
            "event": "minecraft:stop_angry_event",
            "target": "self"
          },
          "outside_range": 15
        },
        "minecraft:movement": {
        "value": 0.6
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": true,
              "on_damage": {
                "event": "stonecraft:on_hurt",
                "target": "self"
              }
            }
          ]
        },
          "minecraft:behavior.avoid_mob_type": {
          "priority": 4,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  }
                ]
              },
              "max_dist": 8,
              "walk_speed_multiplier": 0.7,
              "sprint_speed_multiplier": 0.7
            }
          ]
        }
      },
      "minecraft:hostile": {
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "melee_fov": 90.0,
          "speed_multiplier": 0.65,
          "track_target": false,
          "cooldown_time": 1,
          "require_complete_path": true
        },
        "minecraft:movement": {
          "value": 0.65
        },
        "minecraft:attack": {
          "damage": [6, 8],
          "effect_duration": 10,
          "effect_name": "slowness"
        },
        "minecraft:behavior.hurt_by_target": {
          "entity_types": {
            "filters": {
              "any_of": [
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone_boss"},
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone"}
            ]
            },
            "max_dist": 64
          },
          "priority": 1
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "within_radius": 10,
          "must_reach": false,
          "reselect_targets": true,
          "must_see_forget_duration": 17.0,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "other", "value": "player"},
                  { "test": "is_family", "subject": "other", "value": "snowgolem" },
                  { "test": "is_family", "subject": "other", "value": "irongolem" }
                ]
              },
              "max_dist": 48.0,
              "must_see": true
            }
          ],
          "must_see": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["stone", "neutral_mob", "mob"]
      },
      "minecraft:health": {
        "value": 36,
        "max": 36
      },
      "minecraft:underwater_movement": {
        "value": 0
      },
      "minecraft:navigation.generic": {
        "is_amphibious": false,
        "can_path_over_water": false,
        "can_swim": false,
        "avoid_water": true,
        "avoid_sun": false,
        "can_walk": true,
        "can_break_doors": true,
        "can_pass_doors": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:breathable": {
        "breathes_solids": true,
        "breathes_water": true
      },
      "minecraft:collision_box": {
        "height": 1.8,
        "width": 0.6
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.3
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 8,
        "probability": 0.02,
        "priority": 12
      },
      "minecraft:behavior.random_look_around": {
        "priority": 11
      },
      "minecraft:knockback_resistance": {
        "value": 100
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "filters": {
          "test": "is_difficulty",
          "value": "peaceful"
        }
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 30 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/stone_vagabond.json"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "minecraft:peaceful",
            "stonecraft:molten_sensor"
          ]
        }
      },
      "minecraft:start_angry_event": {
        "add": {
          "component_groups": [
            "stonecraft:start_angry"
          ]
        }
      },
      "minecraft:stop_angry_event": {
        "remove": {
          "component_groups": [
            "stonecraft:start_angry"
          ]
        }
      },
      "stonecraft:start_molten_event": {
        "add": {
          "component_groups": [
            "stonecraft:start_molten"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:molten_sensor"
          ]
        }
      },
      "stonecraft:stop_molten_event": {
        "add": {
          "component_groups": [
            "stonecraft:molten_sensor"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:start_molten"
          ]
        }
      },
      "stonecraft:become_molten_event": {
        "add": {
          "component_groups": ["stonecraft:become_molten"]
        }
      },
      "minecraft:become_hostile": {
        "remove": {
          "component_groups": ["minecraft:peaceful"]
        },
        "add": {
          "component_groups": ["minecraft:hostile"]
        }
      },
      "stonecraft:on_hurt": {
        "remove": {
          "component_groups": ["minecraft:peaceful"]
        },
        "add": {
          "component_groups": ["minecraft:hostile"]
        }
      }
    }
  }
}