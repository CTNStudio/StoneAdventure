{
  "format_version": "1.20.70",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:stone_block",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "stonecraft:remove_resistance":{
        "minecraft:timer": {
          "looping": false,
          "time": 1.5,
          "time_down_event": {
            "event": "stonecraft:remove_resistance_events"
          }
        }
      },
      "stonecraft:stone_block_movement":{
        "minecraft:timer": {
          "time": 2.0,
          "time_down_event": {
            "event": "stonecraft:stop"
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [ "stone", "monster", "mob" ]
      },
      "minecraft:health": {
        "value": 6,
        "max": 6
      },
      "minecraft:scale": {
        "value": 1.5
      },
      "minecraft:collision_box": {
        "height": 0.3,
        "width": 0.3
      },
      "minecraft:movement.basic": {},
      "minecraft:physics": {},
      "minecraft:breathable": {
        "breathes_solids": true,
        "breathes_water": true
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone_boss" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone" }
                ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:underwater_movement": {
        "value": 0
      },
      "minecraft:navigation.generic": {
        "is_amphibious": false,
        "can_path_over_water": false,
        "can_s wim": false,
        "avoid_water": true,
        "avoid_sun": false,
        "can_walk": true,
        "can_break_doors": true,
        "can_pass_doors": true
      },
      "minecraft:jump.static": {},
      "minecraft:knockback_resistance": {
        "value": 100
      },
      "minecraft:movement": {
        "value": 0.5
      },
      "minecraft:attack": {
        "damage": 1,
        "effect_duration": 1,
        "effect_name": "slowness"
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "melee_fov": 90.0,
        "speed_multiplier": 0.5,
        "track_target": false,
        "cooldown_time": 1,
        "require_complete_path": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "within_radius": 10,
        "must_reach": false,
        "reselect_targets": true,
        "must_see_forget_duration": 17.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player"},
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 48.0,
            "must_see": true
          }
        ],
        "must_see": true
      },
      "minecraft:behavior.look_at_player": {
        "priority": 12,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.3
      },
      "minecraft:behavior.random_look_around": {
        "priority": 11
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/stone_block.json"
      },
      "minecraft:despawn": {
        "filters": {
          "test": "is_difficulty",
          "value": "peaceful"
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "effect @s resistance 2 255 true"
          ]
        },
        "add": {
          "component_groups": [ "stonecraft:remove_resistance" ]
        }
      },
      "stonecraft:remove_resistance_events":{
        "queue_command": {
          "command": [
            "effect @s clear"
          ]
        },
        "add": {
          "component_groups": [ "stonecraft:stone_block_movement" ]
        },
        "remove":{
          "component_groups": [ "stonecraft:remove_resistance" ]
        }
      },
      "stonecraft:stop": {
        "queue_command": {
          "command": [
            "effect @s slowness 1 255 true"
          ]
        }
      }
    }
  }
}