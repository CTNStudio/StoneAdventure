{
  "format_version": "1.20.70",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:elder_stone_guard",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "combat_mode": {
        "minecraft:behavior.move_towards_target": {}
      },
      "stonecraft:transformation_sensor": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "any_of": [
                  { "test": "on_fire", "operator": "==", "value": true }
                ]
              },
              "event": "stonecraft:start_molten_event"
            },
            {
              "filters": {
                "test": "in_water",
                "operator": "==",
                "value": true
              },
              "event": "stonecraft:start_mossy_event"
            }
          ]
        }
      },
      "stonecraft:molten_timer": {
        "minecraft:transformation": {
          "into": "stonecraft:molten_elder_stone_guard",
          "transformation_sound": "stonecraft.stone.transform",
          "drop_equipment": false,
          "delay": {
            "value": 10
          }
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "on_fire", "operator": "!=", "value": true }
                ]
              },
              "event": "stonecraft:stop_molten_event"
            }
          ]
        }
      },
      "stonecraft:mossy_timer": {
        "minecraft:transformation": {
          "into": "stonecraft:mossy_elder_stone_guard",
          "transformation_sound": "stonecraft.stone.transform",
          "drop_equipment": false,
          "delay": {
            "value": 15
          }
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "in_water",
                "operator": "!=",
                "value": true
              },
              "event": "stonecraft:stop_mossy_event"
            }
          ]
        }
      }
    },
