{
  "format_version": "1.21.40",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:rock_lion",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },

    "component_groups": {
      "stonecraft:rock_lion_hostile": {
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "melee_fov": 90.0,
          "speed_multiplier": 0.65,
          "track_target": false,
          "require_complete_path": true
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1,
          "entity_types": {
            "filters": {
              "any_of": [
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone_boss"},
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone"}
            ]
            },
            "max_dist": 64
          }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3,
          "within_radius": 10,
          "must_reach": false,
          "reselect_targets": true,
          "must_see_forget_duration": 17.0,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "other", "value": "player"},
                  { "test": "is_family", "subject": "other", "value": "snowgolem" },
                  { "test": "is_family", "subject": "other", "value": "irongolem" }
                ]
              },
              "max_dist": 48.0,
              "must_see": true
            }
          ],
          "must_see": true
        },
        "minecraft:attack": {
          "damage": [6, 8],
          "effect_duration": 10,
          "effect_name": "slowness"
        }
      },

      "stonecraft:rock_lion_tame": {
        "minecraft:is_tamed": {},
        "minecraft:tameable": {
          "probability": 0.33,
          "tame_items": "bone",
          "tame_event": {
            "event": "stonecraft:on_tame",
            "target": "self"
          }
        },
        "minecraft:behavior.teleport_to_owner": {
          "priority": 1,
          "filters": {
            "any_of": [
              {
                "all_of": [
                  {
                    "test": "owner_distance",
                    "operator": ">",
                    "value": 12
                  },
                  { "test": "is_panicking" }
                ]
              },
              {
                "all_of": [
                  {
                    "test": "owner_distance",
                    "operator": ">",
                    "value": 24
                  },
                  { "test": "has_target" }
                ]
              }
            ]
          }
        },
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 5,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 16
            }
          ]
        },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.0,
          "start_distance": 10,
          "stop_distance": 2
        },
        "minecraft:sittable": {},
        "minecraft:attack": {
          "damage": [8, 10]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "melee_fov": 90.0,
          "speed_multiplier": 0.65,
          "track_target": false,
          "require_complete_path": true
        }
      }
    },

    "components": {
      "minecraft:leashable": {
        "soft_distance": 4.0,
