{
  "format_version": "1.20.70",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:sandstone_guard",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "easy_attack": {
        "minecraft:attack": {
          "damage": 6
        }
      },
      "normal_attack": {
        "minecraft:attack": {
          "damage": 7,
          "effect_duration": 5,
          "effect_name": "hunger"
        }
      },
      "hard_attack": {
        "minecraft:attack": {
          "damage": 8,
          "effect_duration": 10,
          "effect_name": "hunger"
        }
      }
    },
    "components": {
      "minecraft:attack": {
        "damage": 7,
        "effect_duration": 5,
        "effect_name": "hunger"
      },
      "minecraft:annotation.open_door": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone_boss" },
                  { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone" }
                ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 8,
        "probability": 0.02,
        "priority": 12
      },
      "minecraft:knockback_resistance": {
        "value": 100
      },
      "minecraft:behavior.move_indoors": {
        "priority": 4
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:breathable": {
        "breathes_solids": true,
        "breathes_water": true
      },
      "minecraft:collision_box": {
        "height": 1.8,
        "width": 0.6
      },
      "minecraft:despawn": {
        "filters": {
          "test": "is_difficulty",
          "value": "peaceful"
        }
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 30 : 0"
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "within_radius": 10,
        "must_reach": false,
        "reselect_targets": true,
        "must_see_forget_duration": 17.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player"},
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 48.0,
            "must_see": true
          }
        ],
        "must_see": true
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "melee_fov": 90.0,
        "speed_multiplier": 1.0,
        "track_target": false,
        "cooldown_time": 1,
        "require_complete_path": true
      },
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/sandstone/sandstone_guard.json"
      },
      "minecraft:movement": {
        "value": 0.18
      },
      "minecraft:movement.basic": {},
      "minecraft:physics": {},
      "minecraft:type_family": {
        "family": ["monster", "stone", "undead", "mob"]
      },
      "minecraft:underwater_movement": {
        "value": 0
      },
      "minecraft:navigation.generic": {
        "is_amphibious": false,
        "can_path_over_water": false,
        "can_swim": false,
        "avoid_water": true,
        "avoid_sun": false,
        "can_walk": true,
        "can_break_doors": true,
        "can_pass_doors": true
      },
      "minecraft:behavior.random_look_around": {
        "priority": 11
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "filters":{ "test": "is_difficulty", "value": "easy" },
            "remove": {
              "component_groups": ["normal_attack", "hard_attack"]
            },
            "add": {
              "component_groups": ["easy_attack"]
            }
          },
          {
            "filters":{ "test": "is_difficulty", "value": "normal" },
            "remove": {
              "component_groups": ["easy_attack", "hard_attack"]
            },
            "add": {
              "component_groups": ["normal_attack"]
            }
          },
          {
            "filters":{ "test": "is_difficulty", "value": "hard" },
            "remove": {
              "component_groups": ["easy_attack", "normal_attack"]
            },
            "add": {
              "component_groups": ["hard_attack"]
            }
          }
        ]
      }
    }
  }
}