{
    "format_version": "1.20.10",
    "minecraft:attachable": {
        "description": {
            "identifier": "stonecraft:wooden_slingshot",
            "materials": {
                "default": "entity_alphatest",
                "enchanted": "entity_alphatest_glint"
            },
            "textures": {
                "default": "textures/items/tools/slingshots/wooden_slingshot",
                "bow_pulling_0": "textures/items/tools/slingshots/wooden_slingshot_1",
                "bow_pulling_1": "textures/items/tools/slingshots/wooden_slingshot_2",
                "bow_pulling_2": "textures/items/tools/slingshots/wooden_slingshot_3",
                "enchanted": "textures/misc/enchanted_item_glint"
            },
            "geometry": {
                "default": "geometry.bow_standby",
                "bow_pulling_0": "geometry.bow_pulling_0",
                "bow_pulling_1": "geometry.bow_pulling_1",
                "bow_pulling_2": "geometry.bow_pulling_2"
            },
            "animations": {
                "wield": "animation.bow.wield",
                "wield_first_person_pull": "animation.bow.wield_first_person_pull"
            },
            "scripts": {
                "pre_animation": [
                    "v.arrows = 0; v.i = 0;",
                    "v.arrows = v.arrows + (q.is_item_name_any('slot.weapon.offhand', 0, 'stonecraft:stone_nugget')?1:0);",
                    "loop(27, {v.arrows = v.arrows + (q.is_item_name_any('slot.inventory', v.i, 'stonecraft:stone_nugget')?1:0); v.i = v.i+1;});",
                    "v.i = 0;",
                    "loop(9, {v.arrows = v.arrows + (q.is_item_name_any('slot.hotbar', v.i, 'stonecraft:stone_nugget')?1:0); v.i = v.i+1;});",
                    "v.charge_amount = (v.arrows > 0 && q.main_hand_item_use_duration > 0.0f) ? (math.clamp((q.main_hand_item_max_duration - q.main_hand_item_use_duration) / 3, 1, 3)) : 0;"
                ],
                "animate": [
                    "wield",
                    {
                        "wield_first_person_pull": "q.main_hand_item_use_duration > 0.0f && c.is_first_person && v.charge_amount"
                    }
                ]
            },
            "render_controllers": [
                "controller.render.wooden_slingshot"
            ]
        }
    }
}