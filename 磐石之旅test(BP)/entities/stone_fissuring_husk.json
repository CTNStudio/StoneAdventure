{
  "format_version": "1.20.70",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:stone_fissuring_husk",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "stonecraft:restore_bombing": {
        "minecraft:timer": {
          "looping": false,
          "time": 60,
          "time_down_event": {
            "event": "stonecraft:restore_bombing_events"
          }
        }
      },
      "stonecraft:bombing":{
        "minecraft:target_nearby_sensor": {
          "inside_range": 1.0,
          "outside_range": 6.0,
          "must_see": true,
          "on_inside_range": {
            "event": "minecraft:start_exploding",
            "target": "self"
          },
          "on_outside_range": {
            "event": "minecraft:stop_exploding",
            "target": "self"
          },
          "on_vision_lost_inside_range": {
            "event": "minecraft:stop_exploding",
            "target": "self"
          }
        },
        "minecraft:on_target_escape": {
          "event": "minecraft:stop_exploding",
          "target": "self"
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": true,
              "on_damage": {
                "event": "stonecraft:on_hurt",
                "target": "self"
              }
            }
          ]
        }
      },
      "stonecraft:molten_sensor": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "any_of": [
                  { "test": "on_fire", "operator": "==", "value": true },
                  { "test": "in_nether", "operator": "==", "value": true }
                ]
              },
              "event": "stonecraft:start_molten_event"
            },
            {
              "filters": {
                "test": "in_water",
                "operator": "==",
                "value": true
              },
              "event": "stonecraft:remove_bombing"
            }
          ]
        }
      },
      "stonecraft:start_molten": {
        "minecraft:environment_sensor": {
          "triggers": {
            "filters": {
              "all_of": [
                    { "test": "on_fire", "subject": "self", "operator": "!=", "value": true},
                    { "test": "in_nether", "subject": "self", "operator": "!=", "value": true }
              ]
            },
            "event": "stonecraft:stop_molten_event"
          }
        },
        "minecraft:timer": {
          "looping": false,
          "time": 5,
          "time_down_event": {
            "event": "stonecraft:become_molten_event"
          }
        }
      },
      "stonecraft:become_molten": {
        "minecraft:transformation": {
          "into": "stonecraft:molten_stone_fissuring_husk",
          //"transformation_sound" : "converted_to_zombified",
          "drop_inventory": true,
          "preserve_equipment": true
        }
      },
      "minecraft:exploding": {
        "minecraft:explode": {
          "fuse_length": 2.0,
          "breaks_blocks": false,
          "fuse_lit": true,
          "power": 3,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        },
        "minecraft:timer": {
          "looping": false,
          "time": 1.8,
          "time_down_event": {
            "event": "stonecraft:deathrattle_event"
          }
        }
      }
    },
    "components": {
      
      "minecraft:annotation.open_door": {},
      
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:behavior.hurt_by_target": {
        "entity_types": {
          "filters": {
            "any_of": [
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone_boss"},
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone"}
            ]
          },
          "max_dist": 64
        },
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 8,
        "probability": 0.02,
        "priority": 12
      },
      "minecraft:knockback_resistance": {
        "value": 100
      },
      "minecraft:behavior.move_indoors": {
        "priority": 4
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.3
      },
      "minecraft:breathable": {
        "breathes_solids": true,
        "breathes_water": true
      },
      "minecraft:collision_box": {
        "height": 1.8,
        "width": 0.6
      },
      "minecraft:despawn": {
        "filters": {
          "test": "is_difficulty",
          "value": "peaceful"
        }
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 30 : 0"
      },
      "minecraft:health": {
        "value": 24
      },
      "minecraft:on_death": {
        "event": "stonecraft:after_death"
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "within_radius": 10,
        "must_reach": false,
        "reselect_targets": true,
        "must_see_forget_duration": 17.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player"},
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 48.0,
            "must_see": true
          }
        ],
        "must_see": true
      },
      "minecraft:attack": {
        "damage": [5, 7],
        "effect_duration": 10,
        "effect_name": "slowness"
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "melee_fov": 90.0,
        "speed_multiplier": 0.65,
        "track_target": false,
        "require_complete_path": true,
        "cooldown_time": 1,
        "reach_multiplier":  0.0
      },
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/stone_fissuring_husk.json"
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:movement.basic": {},
      "minecraft:physics": {},
      "minecraft:type_family": {
        "family": ["monster", "stone", "undead", "mob"]
      },
      "minecraft:underwater_movement": {
        "value": 0
      },
      "minecraft:navigation.generic": {
        "is_amphibious": false,
        "can_path_over_water": false,
        "can_swim": false,
        "avoid_water": true,
        "avoid_sun": false,
        "can_walk": true,
        "can_break_doors": true,
        "can_pass_doors": true
      },
      "minecraft:behavior.random_look_around": {
        "priority": 11
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["stonecraft:molten_sensor","stonecraft:bombing"]
        }
      },
      "stonecraft:remove_bombing":{
        "remove": {
          "component_groups": [
            "stonecraft:bombing"
          ]
        },
        "add":{
          "component_groups": [
            "stonecraft:restore_bombing"
          ]
        }
      },
      "stonecraft:restore_bombing_events":{
        "remove": {
          "component_groups": [
            "stonecraft:restore_bombing"
          ]
        },
        "add":{
          "component_groups": [
            "stonecraft:bombing"
          ]
        }
      },
      "stonecraft:start_molten_event": {
        "add": {
          "component_groups": [
            "stonecraft:start_molten"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:molten_sensor"
          ]
        }
      },
      "stonecraft:stop_molten_event": {
        "add": {
          "component_groups": [
            "stonecraft:molten_sensor"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:start_molten"
          ]
        }
      },
      "stonecraft:become_molten_event": {
        "add": {
          "component_groups": ["stonecraft:become_molten"]
        }
      },
      "stonecraft:after_death": {
        "sequence": [
          {
            "queue_command": {
              "command": [
                "summon stonecraft:stone_block ~ ~ ~",
                "summon stonecraft:stone_block ~ ~ ~",
                "summon stonecraft:stone_block ~ ~ ~"
              ]
            }
          }
        ]
      },
      "stonecraft:on_hurt": {
        "randomize":[
          {
            "weight": 50
          },
          {
            "weight": 50,
            "queue_command": {
              "command": [
                "gamerule sendcommandfeedback false",
                "summon stonecraft:stone_block ~ ~ ~",//哈气了
                "gamerule sendcommandfeedback true"
              ]
            }
          }
        ] 
      },
      "minecraft:start_exploding": {
        "add": {
          "component_groups": [
            "minecraft:exploding"
          ]
        }
      },
      "stonecraft:deathrattle_event": {
        "queue_command": {
          "command": [
            "summon stonecraft:stone_block ~ ~ ~",
            "summon stonecraft:stone_block ~ ~ ~",
            "summon stonecraft:stone_block ~ ~ ~"//哈气了
          ]
        }
      },
      "minecraft:stop_exploding": {
        "remove": {
          "component_groups": [
            "minecraft:exploding"
          ]
        }
      }
    }
  }
}