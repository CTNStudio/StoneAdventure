{
  "format_version": "1.20.70",
  "minecraft:entity": {
    "description": {
      "identifier": "stonecraft:deepslate_stone_guard",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "easy_attack": {
        "minecraft:attack": {
          "damage": 6,
          "effect_duration": 5,
          "effect_name": "slowness"
        }
      },
      "normal_attack": {
        "minecraft:attack": {
          "damage": 7,
          "effect_duration": 10,
          "effect_name": "slowness"
        }
      },
      "hard_attack": {
        "minecraft:attack": {
          "damage": 8,
          "effect_duration": 15,
          "effect_name": "slowness"
        }
      },
      "stonecraft:transformation_sensor": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "any_of": [
                  { "test": "on_fire", "operator": "==", "value": true },
                  { "test": "in_nether", "operator": "==", "value": true }
                ]
              },
              "event": "stonecraft:start_molten_event"
            },
            {
              "filters": {
                "test": "in_water",
                "operator": "==",
                "value": true
              },
              "event": "stonecraft:start_mossy_event"
            }
          ]
        }
      },
      "stonecraft:molten_timer": {
        "minecraft:transformation": {
          "into": "stonecraft:molten_stone_guard",
          "transformation_sound": "stonecraft.stone.transform",
          "drop_equipment": true,
          "delay": {
            "value": 8
          }
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "on_fire", "operator": "!=", "value": true },
                  { "test": "in_nether", "operator": "!=", "value": true }
                ]
              },
              "event": "stonecraft:stop_molten_event"
            }
          ]
        }
      },
      "stonecraft:mossy_timer": {
        "minecraft:transformation": {
          "into": "stonecraft:mossy_stone_guard",
          "transformation_sound": "stonecraft.stone.transform",
          "drop_equipment": true,
          "delay": {
            "value": 15
          }
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "test": "in_water",
                "operator": "!=",
                "value": true
              },
              "event": "stonecraft:stop_mossy_event"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:attack": {
        "damage": 7,
        "effect_duration": 10,
        "effect_name": "slowness"
      },
      "minecraft:annotation.open_door": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:behavior.hurt_by_target": {
        "entity_types": {
          "filters": {
            "any_of": [
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone_boss"},
              { "test": "is_family", "subject": "other", "operator": "!=", "value": "stone"}
            ]
          },
          "max_dist": 64
        },
        "priority": 1
      },
      "minecraft:behavior.look_at_player": {
        "look_distance": 8,
        "probability": 0.02,
        "priority": 12
      },
      "minecraft:knockback_resistance": {
        "value": 100
      },
      "minecraft:behavior.move_indoors": {
        "priority": 4
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:breathable": {
        "breathes_solids": true,
        "breathes_water": true
      },
      "minecraft:collision_box": {
        "height": 1.8,
        "width": 0.6
      },
      "minecraft:despawn": {
        "filters": {
          "test": "is_difficulty",
          "value": "peaceful"
        }
      },
      "minecraft:equip_item": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 30 : 0"
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "within_radius": 10,
        "must_reach": false,
        "reselect_targets": true,
        "must_see_forget_duration": 17.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" },
                { "test": "is_family", "subject": "other", "value": "warden" }
              ]
            },
            "max_dist": 48.0,
            "must_see": true
          }
        ],
        "must_see": true
      },
      "minecraft:health": {
        "value": 46,
        "max": 46
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "melee_fov": 90.0,
        "speed_multiplier": 1.0,
        "track_target": false,
        "require_complete_path": true
      },
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/deepslate/deepslate_stone_guard.json"
      },
      "minecraft:movement": {
        "value": 0.15
      },
      "minecraft:movement.basic": {},
      "minecraft:physics": {},
      "minecraft:type_family": {
        "family": ["monster", "stone", "undead", "mob"]
      },
      "minecraft:underwater_movement": {
        "value": 0
      },
      "minecraft:navigation.generic": {
        "is_amphibious": false,
        "can_path_over_water": false,
        "can_swim": false,
        "avoid_water": true,
        "avoid_sun": false,
        "can_walk": true,
        "can_break_doors": true,
        "can_pass_doors": true
      },
      "minecraft:behavior.random_look_around": {
        "priority": 11
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "stonecraft:transformation_sensor"
              ]
            }
          },
          {
            "filters":{ "test": "is_difficulty", "value": "easy" },
            "remove": {
              "component_groups": ["normal_attack", "hard_attack"]
            },
            "add": {
              "component_groups": ["easy_attack"]
            }
          },
          {
            "filters":{ "test": "is_difficulty", "value": "normal" },
            "remove": {
              "component_groups": ["easy_attack", "hard_attack"]
            },
            "add": {
              "component_groups": ["normal_attack"]
            }
          },
          {
            "filters":{ "test": "is_difficulty", "value": "hard" },
            "remove": {
              "component_groups": ["easy_attack", "normal_attack"]
            },
            "add": {
              "component_groups": ["hard_attack"]
            }
          }
        ]
      },
      "stonecraft:start_molten_event": {
        "add": {
          "component_groups": [
            "stonecraft:molten_timer"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:transformation_sensor"
          ]
        }
      },
      "stonecraft:stop_molten_event": {
        "add": {
          "component_groups": [
            "stonecraft:transformation_sensor"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:molten_timer"
          ]
        }
      },
      "stonecraft:start_mossy_event": {
        "add": {
          "component_groups": [
            "stonecraft:mossy_timer"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:transformation_sensor"
          ]
        }
      },
      "stonecraft:stop_mossy_event": {
        "add": {
          "component_groups": [
            "stonecraft:transformation_sensor"
          ]
        },
        "remove": {
          "component_groups": [
            "stonecraft:mossy_timer"
          ]
        }
      }
    }
  }
}